APP_NAME="Projukti Sheba CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Dhaka"
APP_URL=https://crm.projuktisheba.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projukti_sheba_crm_prod
DB_USERNAME=projukti_prod_user
DB_PASSWORD=SecureProductionPassword_2026!

# Session & Cookie Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# Mail Configuration (SMTP / Postmark / Mailgun)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@crm.projuktisheba.com
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@projuktisheba.com"
MAIL_FROM_NAME="Projukti Sheba Notification"

# Automated Reminders & Database Backup Settings (SRS Section 53)
BACKUP_RETENTION_DAYS=30

# WhatsApp Cloud API & Webhook Configuration (SRS Section 40)
WHATSAPP_API_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=projukti_webhook_secret_verify_2026
WHATSAPP_API_VERSION=v20.0
